<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>1С в контейнере</title>
<script>
	// x11vnc отдаёт этот файл на запрос корня и подставляет порт VNC вместо PORT со знаком доллара;
	// WebSocket принимает сам x11vnc на порту VNC, а не на порту страницы
	var settings = { autoconnect: '1', resize: 'scale', reconnect: '1', reconnect_delay: '2000', port: '$PORT' };
	new URLSearchParams(location.search).forEach(function (value, key) { settings[key] = value; });
	location.replace('vnc.html?' + new URLSearchParams(settings).toString());
</script>
</head>
<body></body>
</html>
